---
---

<section
  id="hero"
  class="relative flex h-screen min-h-[560px] items-center justify-center overflow-hidden text-center"
>
  <div
    class="absolute inset-0 scale-105 bg-charcoal bg-cover bg-center"
    style="background-image: url('/assets/img/hero-placeholder.svg');"
  >
  </div>

  <div
    class="absolute inset-0 bg-[linear-gradient(180deg,rgb(10_10_10_/_55%)_0%,rgb(10_10_10_/_75%)_55%,var(--color-ink)_100%),radial-gradient(ellipse_at_center,rgb(179_18_27_/_18%)_0%,rgb(10_10_10_/_0%)_60%)]"
  >
  </div>

  <div class="relative z-10 max-w-[780px] px-5">
    <h1
      class="font-display text-[clamp(2.8rem,9vw,6rem)] leading-[1.05] font-black tracking-wide text-bone [text-shadow:0_0_40px_rgb(179_18_27_/_55%),0_4px_12px_rgb(0_0_0_/_80%)]"
    >
      MEMENTOMORIUM
    </h1>
    <p class="mx-auto mt-6 mb-10 max-w-[560px] text-[clamp(1rem,2vw,1.2rem)] tracking-wide text-ash">
      Aus Asche geboren. Aus Lärm geformt. Erinnere dich, dass du sterblich bist.
    </p>
    <a
      href="#tourdaten"
      class="inline-block rounded-sm border-2 border-blood bg-blood px-8 py-3.5 text-sm font-semibold tracking-widest text-bone uppercase transition hover:-translate-y-0.5 hover:border-blood-bright hover:bg-blood-bright"
    >
      Tourdaten ansehen
    </a>
  </div>

  <a
    href="#musik"
    aria-label="Nach unten scrollen"
    class="absolute bottom-8 left-1/2 z-10 h-10.5 w-6.5 -translate-x-1/2 rounded-full border-2 border-ash"
  >
    <span class="absolute top-2 left-1/2 h-2 w-1 -translate-x-1/2 animate-scroll-down rounded-full bg-blood-bright">
    </span>
  </a>
</section>
